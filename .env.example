# ── Supabase (frontend, safe to ship) ────────────────────────────
# From Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Legal / company configuration (frontend) ─────────────────────
# Launch stays blocked until the required ones are set (see src/config/legal.js)
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_REG_NUMBER=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_PRIVACY_EMAIL=
VITE_SUPPORT_EMAIL=
VITE_DATA_RETENTION_MONTHS=24
VITE_POLICY_EFFECTIVE_DATE=
VITE_POLICY_VERSION=2026-01-01
VITE_GOVERNING_JURISDICTION=Монгол Улс

# ══════════════════════════════════════════════════════════════════
# SERVER-ONLY SECRETS — never in the frontend, never committed.
# Set these in Supabase → Edge Functions → Secrets, NOT in this file's
# real .env counterpart on a client build.
# ══════════════════════════════════════════════════════════════════
# SUPABASE_SERVICE_ROLE_KEY=   # bypasses RLS — server only
# SUPABASE_ANON_KEY=           # for Edge Functions to verify caller tokens
# GEMINI_API_KEY=              # AI candidate summary
# ALLOWED_ORIGIN=              # CORS origin for Edge Functions
